{
    "name": "mj-zana/http",
    "description": "PSR-7/15/17 HTTP kernel with a container scope per request, middleware and error handling for Zana applications",
    "type": "library",
    "keywords": ["zana", "http", "psr-7", "psr-15", "psr-17", "middleware", "kernel"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.4",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Http\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.4.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.4.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.4.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
